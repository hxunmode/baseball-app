{
  "expo": {
    "name": "baseball-app",
    "slug": "baseball-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "리워드 이미지를 사진 앨범에 저장하기 위해 접근 권한이 필요합니다."
      },
      "bundleIdentifier": "com.catchtowin.app"
    },
    "android": {
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.catchtowin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "리워드 이미지를 사진 앨범에 저장하기 위해 접근 권한이 필요합니다.",
          "savePhotosPermission": "리워드 이미지를 사진 앨범에 저장하기 위해 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7dac7bec-bc5d-46ed-8412-e59ca0f6f045"
      }
    }
  }
}
